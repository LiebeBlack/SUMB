      <LinkIncremental>false</LinkIncremental>
      <AdditionalLibraryDirectories>$(WDKRoot)\Lib\10.0.26100.0\km\x64;$(WDKRoot)\Lib\wdf\kmdf\x64\1.33;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>BufferOverflowK.lib;ntoskrnl.lib;hal.lib;wmilib.lib;wdmsec.lib;WdfLdr.lib;WdfDriverEntry.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- /DRIVER marca el binario como driver de kernel (subsystem native, .sys),
           /KERNEL fuerza verificaciones kernel-mode y /NODEFAULTLIB excluye el CRT
